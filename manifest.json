{
  "manifest_version": 3,
  "name": "Chess.com Tools",
  "version": "3.7",
  "description": "Adds a floating review button and blocks ads on Chess.com, managed remotely via Firebase.",
  "permissions": [
    "tabs",
    "windows",
    "storage",
    "scripting",
    "declarativeNetRequest",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "*://*.chess.com/*",
    "https://dogchess.web.app/*",
    "https://*.dogchess.shop/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://*.firebaseio.com https://www.googleapis.com https://identitytoolkit.googleapis.com https://firestore.googleapis.com https://securetoken.googleapis.com;"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": false,
        "path": "rules.json"
      }
    ]
  },
  "externally_connectable": {
    "matches": [
      "http://localhost:5500/*",
      "https://chessy-me-website.web.app/*",
      "https://*.chessy.me/*",
      "https://dogchess.web.app/*",
      "https://*.dogchess.shop/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chess.com/game/*",
        "*://*.chess.com/analysis/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"]
    },
    {
      "matches": [
        "http://localhost:5500/*",
        "https://chessy-me-website.web.app/*",
        "https://*.chessy.me/*",
        "https://dogchess.web.app/*",
        "https://*.dogchess.shop/*"
      ],
      "js": ["sync-bridge.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png"
    }
  },
  "incognito": "spanning",
  "icons": {
    "16": "icon.png"
  }
}